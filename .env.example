# LLM — Default: lokal (Ollama LAN) — kein Secret/API-Key
LITELLM_PORT=4000
OLLAMA_HOST=192.168.178.64
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=qwen3.6-64k:latest
DEFAULT_COMPUTE_MODE=sovereign

# Cloud — OpenRouter Free-Modelle (balanced/premium/coding); Key: https://openrouter.ai/keys
# Limits: 20 req/min, 50 req/Tag (ohne Credits) bzw. 1000/Tag nach einmalig $10 Guthaben
OPENROUTER_API_KEY=

# LangFuse (Pflicht ab Tag 1)
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PG_PW=changeme-langfuse-pg
LANGFUSE_SECRET=changeme-langfuse-nextauth-secret-32chars
LANGFUSE_SALT=changeme-langfuse-salt

# Datenbank
POSTGRES_HOST=postgres-platform
POSTGRES_DB=aios
POSTGRES_USER=aios
POSTGRES_PASSWORD=changeme-aios-pg

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_CONTENT=content
QDRANT_COLLECTION_SKILLS=skills

# Letta — Orchestrator laeuft auf Host; published Port 8283
LETTA_URL=http://127.0.0.1:8283
LETTA_HOST=127.0.0.1
LETTA_PORT=8283
LETTA_API_KEY=
LETTA_ENABLED=true
LETTA_AGENTS_STATE=/opt/ai-os/memory/state/letta-agents.json
LETTA_SYNC_STATE=/opt/ai-os/memory/state/letta-sync.json

# Memory SQLite
AIOS_MEMORY_DB=/opt/ai-os/memory/memory.db
AIOS_MEMORY_ROOT=/opt/ai-os/memory
AIOS_MEMORY_PROJECT=home-peter-Projekte

# Qdrant (Host-Orchestrator)
QDRANT_URL=http://127.0.0.1:6333
SEARCH_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ORCHESTRATOR_URL=http://127.0.0.1:8091

# Services
ORCHESTRATOR_PORT=8091
CONSOLE_PORT=8092
CONSOLE_API_PORT=8093
MCP_GATEWAY_PORT=8097
SKILL_SERVICE_PORT=8095
SCHEDULER_PORT=8096

# Tenant — NCE First-Party auf DEV-VM
DEFAULT_TENANT=nextchapter
