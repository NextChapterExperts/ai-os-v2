[Unit]
Description=AI-OS MCP Gateway (FastAPI)
After=network.target aios-docker-stack.service
Wants=aios-docker-stack.service

[Service]
Type=simple
WorkingDirectory=%h/Projekte/1100-AI-OS-V2
ExecStart=%h/Projekte/1100-AI-OS-V2/core/mcp_gateway/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
