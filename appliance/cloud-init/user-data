#cloud-config
# Platform-VM cloud-init Vorlage (Stub Phase 0) — später image-build.sh
hostname: ai-os
manage_etc_hosts: true
users:
  - name: aios
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false

package_update: true
package_upgrade: true
packages:
  - curl
  - ca-certificates
  - git
  - openssh-server

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker aios
  - mkdir -p /opt/ai-os/ingest/inbox
  - systemctl enable --now docker

final_message: "AI-OS Platform-VM cloud-init fertig (Stub)."
